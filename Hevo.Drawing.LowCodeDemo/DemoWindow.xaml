<Window x:Class="Hevo.Drawing.LowCodeDemo.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hevo.Drawing.LowCodeDemo"
        xmlns:gv="clr-namespace:Hevo.Charting.LowCode.Designer.GraphViewer;assembly=Hevo.Charting"
        Title="低代码蓝图编辑器 Demo" Height="768" Width="1366"
        Background="#FF1A1B1F" WindowStartupLocation="CenterScreen">
    <TabControl Background="#FF1A1B1F"
                BorderBrush="#FF2A2C34" BorderThickness="0"
                TabStripPlacement="Top">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Background"   Value="#FF24262C"/>
                <Setter Property="Foreground"   Value="#FFC0C8D0"/>
                <Setter Property="BorderBrush"  Value="#FF3A3C44"/>
                <Setter Property="Padding"      Value="14,6"/>
                <Setter Property="FontFamily"   Value="Segoe UI"/>
                <Setter Property="FontSize"     Value="13"/>
            </Style>
        </TabControl.Resources>

        <!-- 单 Cell 编辑器（原 GraphViewer） -->
        <TabItem Header="单 Cell 编辑器">
            <local:LowCodeDemoView/>
        </TabItem>

        <!-- D1.3 多 Cell Dashboard 编辑器 -->
        <TabItem Header="Dashboard 编辑器">
            <gv:DashboardWorkspace x:Name="dashboardWorkspace"/>
        </TabItem>
    </TabControl>
</Window>
