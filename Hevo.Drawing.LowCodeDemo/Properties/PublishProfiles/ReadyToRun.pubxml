<?xml version="1.0" encoding="utf-8"?>
<!--
  Release 发布 + ReadyToRun:发布时把本程序集预编译成本机代码,省掉冷启动 JIT。
  只在显式指定本 profile 时生效,不影响 Debug / 测试 / 普通 build 和 CI(R2R 需要 RuntimeIdentifier)。
    dotnet publish -c Release -p:PublishProfile=ReadyToRun
  实测(render-probe Startup,2000 根 K 线,6 次进程中位数):冷启动 装配 + 首帧 JIT ~242ms → R2R ~194ms。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>bin\publish\r2r\</PublishDir>
  </PropertyGroup>
</Project>
