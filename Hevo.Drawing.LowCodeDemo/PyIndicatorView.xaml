<UserControl x:Class="Hevo.Drawing.LowCodeDemo.PyIndicatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1B1F"
             FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#FFC0C8D0" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run FontWeight="Bold" Foreground="#FF66BB6A">§D2.5.E2E Python Smoke Test</Run>
            <LineBreak/>
            <Run Foreground="#FF8A929C">前置:本机已装 Python 3.8-3.12 + </Run>
            <Run FontFamily="Consolas" Foreground="#FFFFB74D">pip install numpy</Run>
            <Run Foreground="#FF8A929C">,env </Run>
            <Run FontFamily="Consolas" Foreground="#FFFFB74D">PYTHONNET_PYDLL</Run>
            <Run Foreground="#FF8A929C"> 指向 python3X.dll(或留空让自动探测)。</Run>
        </TextBlock>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="btnSmoke" Content="① 运行 Python 计算 Smoke Test" Padding="10,6" Margin="0,0,8,4"
                    Background="#FF2A4A6E" Foreground="White" BorderBrush="#FF4FC3F7"/>
            <Button x:Name="btnTradeDemo" Content="② Python → Mock 交易 demo" Padding="10,6" Margin="0,0,8,4"
                    Background="#FF6E2A4A" Foreground="White" BorderBrush="#FFEF5350"/>
            <Button x:Name="btnRealtimeStart" Content="③ ▶ 实时多指标推流(RSI+MACD+BB+综合打分)" Padding="10,6" Margin="0,0,8,4"
                    Background="#FF2A6E4A" Foreground="White" BorderBrush="#FF66BB6A"/>
            <Button x:Name="btnRealtimeStop" Content="■ 停止" Padding="10,6" Margin="0,0,8,4"
                    Background="#FF3A3C44" Foreground="#FFEF5350" BorderBrush="#FFEF5350" IsEnabled="False"/>
            <Button x:Name="btnFullStrategy" Content="④ 完整策略 demo(BB突破+下单+通知)" Padding="10,6" Margin="0,0,8,4"
                    Background="#FF6E4A2A" Foreground="White" BorderBrush="#FFFFB74D"/>
            <Button x:Name="btnClear" Content="清屏" Padding="10,6" Margin="0,0,0,4"
                    Background="#FF2A2C34" Foreground="#FFC0C8D0" BorderBrush="#FF3A3C44"/>
        </WrapPanel>

        <TextBlock Grid.Row="2" x:Name="txtStatus" Foreground="#FF8A929C" Margin="0,0,0,4" Text="待运行..."/>

        <Border Grid.Row="3" Background="#FF14161B" BorderBrush="#FF2A2C34" BorderThickness="1"
                Padding="10,8" Margin="0,0,0,8" CornerRadius="3">
            <TextBlock x:Name="txtLive" FontFamily="Consolas" FontSize="13" Foreground="#FF8A929C"
                       Text="未启动实时推流" TextWrapping="Wrap"/>
        </Border>

        <TextBox Grid.Row="4" x:Name="txtOutput" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 Background="#FF0E0F12" Foreground="#FFD0D8E0"
                 BorderBrush="#FF2A2C34" BorderThickness="1"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 Padding="8"/>
    </Grid>
</UserControl>
